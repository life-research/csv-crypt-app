{
  "name": "csv-crypt-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:single": "BUILD_TARGET=single vite build && node scripts/finish-single.js",
    "build:desktop": "BUILD_TARGET=desktop vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures": "sh scripts/make-fixtures.sh",
    "cross-check": "sh scripts/cross-check.sh",
    "test:e2e": "npm run build && npm run build:single && playwright test",
    "test:e2e:desktop": "playwright test --config playwright.desktop.config.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "desktop:build:macos": "tauri build --target universal-apple-darwin --bundles dmg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.0.0",
    "rollup-plugin-sbom": "^4.0.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.2",
    "svelte-eslint-parser": "^1.6.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
