{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSV Crypt",
  "version": "../package.json",
  "identifier": "de.uni-leipzig.life.csv-crypt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../build-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CSV Crypt",
        "width": 900,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "capabilities": ["default"],
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "form-action": "'none'",
        "base-uri": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Leipzig Research Centre for Civilization Diseases (LIFE)",
    "copyright": "Copyright © 2026 Leipzig Research Centre for Civilization Diseases (LIFE)",
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
